# ADTM environment (dev defaults). Copy to .env. NEVER commit .env.
POSTGRES_USER=adtm
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=adtm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dev-only key material. In production these come from the client KMS/HSM (see ADR-0007).
# KEK = key-encryption key (wraps per-domain data keys). BLIND_INDEX_KEY per deployment.
ADTM_KEK_DEV=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLWFlcy1nY20h
ADTM_BLIND_INDEX_KEY_DEV=ZGV2LWJsaW5kLWluZGV4LWtleS0zMmJ5dGVzLWhtYWMh

# Bronze storage root (local object/file storage inside the client boundary)
ADTM_DATA_ROOT=/data

# AI gateway (interface only; model selected per client - ADR-0005)
ADTM_AI_BASE_URL=http://ai-runtime:11434
ADTM_AI_ENABLED=false
